# API key for Voyage AI (used for embeddings)
VOYAGE_API_KEY=my_voyage_api_key_here

# Chroma Cloud credentials (used for vector storage/search)
CHROMA_API_KEY=my_chroma_api_key_here
CHROMA_TENANT=my_chroma_tenant_id_here
CHROMA_DATABASE=my_chroma_database_name_here

# API key for Claude (used for generating answers)
ANTHROPIC_API_KEY=my_anthropic_api_key_here

# Signs the visitor cookie. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_random_secret_here
# Set to 1 on the deployed site (HTTPS only); leave empty locally
COOKIE_SECURE=